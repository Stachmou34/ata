AddDefaultCharset UTF-8
ErrorDocument 404 /erreur-404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Ancien domaine -> nouveau domaine (301 permanente, conserve le chemin)
  RewriteCond %{HTTP_HOST} ^(www\.)?assurancetemporaireauto\.com$ [NC]
  RewriteRule ^(.*)$ https://aman-frontiere.com/$1 [R=301,L]

  # 2) Forcer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 3) Forcer la version sans www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 4) Anciennes pages Sete (supprimees) -> pages equivalentes
  RewriteRule ^ar/sete/?$ /ar/ [R=301,L]
  RewriteRule ^sete/?$ / [R=301,L]

  # 5) Ancienne URL WebSite X5
  RewriteRule ^index\.html$ / [R=301,L]

  # 6) Protection contre les injections via query string
  RewriteCond %{REQUEST_METHOD} GET
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=http:// [OR]
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=(\.\.//?)+ [OR]
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=/([a-z0-9_.]//?)+ [NC]
  RewriteRule .* - [F]
</IfModule>

<IfModule mod_autoindex.c>
  IndexIgnore *
  Options +FollowSymLinks -Indexes
</IfModule>

# Compression
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/xhtml+xml text/css text/javascript application/javascript application/x-javascript image/svg+xml
  </IfModule>
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType text/html "access plus 1 hours"
</IfModule>

# En-tetes de securite
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always append X-Frame-Options SAMEORIGIN
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options nosniff
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "accelerometer=(), geolocation=(), camera=(), microphone=()"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php72 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
