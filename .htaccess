AddDefaultCharset UTF-8
ErrorDocument 404 /erreur-404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Ancien domaine -> nouveau domaine (301 permanente, conserve le chemin)
  RewriteCond %{HTTP_HOST} ^(www\.)?assurancetemporaireauto\.com$ [NC]
  RewriteRule ^(.*)$ https://aman-frontiere.com/$1 [R=301,L]

  # 2) Forcer HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 3) Forcer la version sans www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 4) Anciennes pages Sete (supprimees) -> pages equivalentes
  RewriteRule ^ar/sete/?$ /ar/ [R=301,L]
  RewriteRule ^sete/?$ / [R=301,L]

  # 5) Ancienne URL WebSite X5
  RewriteRule ^index\.html$ / [R=301,L]

  # 6) Protection contre les injections via query string
  RewriteCond %{REQUEST_METHOD} GET
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=http:// [OR]
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=(\.\.//?)+ [OR]
  RewriteCond %{QUERY_STRING} [a-zA-Z0-9_]=/([a-z0-9_.]//?)+ [NC]
  RewriteRule .* - [F]
</IfModule>

<IfModule mod_autoindex.c>
  IndexIgnore *
  Options +FollowSymLinks -Indexes
</IfModule>

# Compression
# NB : AddOutputFilterByType doit rester en dehors de <IfModule mod_filter.c>.
# Quand mod_filter n'est pas charge, le bloc imbrique est ignore et rien n'est compresse.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml application/xml application/xhtml+xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/xhtml+xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
  # Repli : sur cet hebergeur, AddOutputFilterByType ne s'applique qu'au text/html.
  # SetOutputFilter par extension prend le relais pour les autres fichiers.
  <FilesMatch "\.(css|js|mjs|svg|json|xml|txt|webmanifest)$">
    SetOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# Cache navigateur
# Les CSS/JS sont appeles avec un parametre de version (?v=...), on peut donc
# les mettre en cache un an : changer la version suffit a forcer le rechargement.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/html "access plus 1 hours"
</IfModule>

<IfModule mod_headers.c>
  # CSS/JS : appeles avec ?v=..., donc "immutable" sans risque
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images : cache long mais sans "immutable", pour pouvoir en remplacer une
  # sans renommer le fichier si besoin
  <FilesMatch "\.(png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# En-tetes de securite
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always append X-Frame-Options SAMEORIGIN
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options nosniff
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "accelerometer=(), geolocation=(), camera=(), microphone=()"
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php72 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
